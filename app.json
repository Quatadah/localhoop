{
  "expo": {
    "name": "Local Loop",
    "slug": "local-loop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "local-loop",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#14B8A6"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Local Loop to use your location to show nearby community posts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Local Loop to access your photos to share in community posts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}